# Backend Environment Configuration
# Copy this to .env and fill in your values

# Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/evoting_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# Blockchain Configuration
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=0x...your-private-key-here
BLOCKCHAIN_GAS_LIMIT=3000000
BLOCKCHAIN_GAS_PRICE=20
VOTING_CONTRACT_ADDRESS=0x...deployed-contract-address

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_DEVELOPMENT_MODE=true

# Risk Engine Configuration
RISK_SCORE_FAILED_LOGIN_THRESHOLD=3
RISK_SCORE_FAILED_LOGIN_POINTS=20
RISK_SCORE_NEW_SESSION_POINTS=15
RISK_SCORE_REPEAT_REQUESTS_POINTS=25
RISK_SCORE_UNUSUAL_FREQUENCY_POINTS=20
RISK_SCORE_SESSION_CHANGES_POINTS=10

RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=60

# Rate Limiting
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5
RATE_LIMIT_GENERAL_REQUESTS_PER_MINUTE=100
RATE_LIMIT_VOTING_REQUESTS_PER_MINUTE=1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# Application Configuration
APP_NAME=Adaptive Blockchain E-Voting System
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Blockchain Network Configuration
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONFIRMATION_BLOCKS=1
BLOCKCHAIN_TRANSACTION_TIMEOUT_SECONDS=120

# Security
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

# Audit Configuration
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_SENSITIVE_EVENTS_ONLY=false

# Experiment Configuration
EXPERIMENT_SIMULATION_MODE=true
EXPERIMENT_CONCURRENT_LIMIT=1
